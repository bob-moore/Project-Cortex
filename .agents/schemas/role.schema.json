{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-vault-harness.local/schemas/role.schema.json",
  "title": "Role Contract",
  "type": "object",
  "required": [
    "name",
    "version",
    "summary",
    "owns",
    "does_not_own",
    "approval_classes",
    "writes",
    "external_reads",
    "external_mutations",
    "required_context",
    "verification_obligations",
    "return_contract",
    "parent_closure_required"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "owns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "does_not_own": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read_only",
          "vault_write",
          "adapter_write",
          "external_read",
          "external_mutation",
          "destructive",
          "production",
          "secret"
        ]
      },
      "minItems": 1
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_mutations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "return_contract": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "parent_closure_required": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": false
}
