{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-vault-harness.local/schemas/verification-result.schema.json",
  "title": "Verification Result",
  "type": "object",
  "required": [
    "status",
    "subject",
    "checks",
    "evidence",
    "open_items"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "blocked"]
    },
    "subject": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
