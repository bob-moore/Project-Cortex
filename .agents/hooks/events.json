{
  "version": 1,
  "script_root": ".agents/hooks/scripts",
  "hooks": [
    {
      "id": "session-start",
      "script": "session-start.ts",
      "timeout_seconds": 30,
      "runtimes": {
        "claude": {
          "event": "SessionStart",
          "matcher": "startup|resume|clear|compact"
        },
        "codex": {
          "event": "SessionStart",
          "matcher": "startup|resume"
        },
        "gemini": {
          "event": "SessionStart",
          "matcher": "startup|resume"
        }
      }
    },
    {
      "id": "classify-message",
      "script": "classify-message.ts",
      "timeout_seconds": 15,
      "runtimes": {
        "claude": {
          "event": "UserPromptSubmit"
        },
        "codex": {
          "event": "UserPromptSubmit"
        },
        "gemini": {
          "event": "BeforeAgent"
        }
      }
    },
    {
      "id": "validate-write",
      "script": "validate-write.ts",
      "timeout_seconds": 15,
      "runtimes": {
        "claude": {
          "event": "PostToolUse",
          "matcher": "Write|Edit"
        },
        "codex": {
          "event": "PostToolUse",
          "matcher": "Write|Edit"
        },
        "gemini": {
          "event": "AfterTool",
          "matcher": "Write|Edit"
        }
      }
    },
    {
      "id": "qmd-refresh",
      "script": "qmd-refresh.ts",
      "timeout_seconds": 15,
      "runtimes": {
        "claude": {
          "event": "PostToolUse",
          "matcher": "Write|Edit"
        },
        "codex": {
          "event": "PostToolUse",
          "matcher": "Write|Edit"
        },
        "gemini": {
          "event": "AfterTool",
          "matcher": "Write|Edit"
        }
      }
    },
    {
      "id": "pre-compact",
      "script": "pre-compact.ts",
      "timeout_seconds": 30,
      "runtimes": {
        "claude": {
          "event": "PreCompact"
        },
        "gemini": {
          "event": "PreCompress"
        }
      }
    },
    {
      "id": "stop-checklist",
      "script": "stop-checklist.ts",
      "timeout_seconds": 5,
      "runtimes": {
        "claude": {
          "event": "Stop"
        },
        "gemini": {
          "event": "SessionEnd"
        }
      }
    },
    {
      "id": "codex-stop",
      "script": "codex-stop.ts",
      "timeout_seconds": 5,
      "runtimes": {
        "codex": {
          "event": "Stop"
        }
      }
    },
    {
      "id": "graphify-hook-check",
      "script": "graphify-hook-check.ts",
      "timeout_seconds": 5,
      "runtimes": {
        "codex": {
          "event": "PreToolUse",
          "matcher": "Bash"
        }
      }
    },
    {
      "id": "graphify-hook-guard-gemini",
      "script": "graphify-hook-guard-gemini.ts",
      "timeout_seconds": 5,
      "runtimes": {
        "gemini": {
          "event": "BeforeTool",
          "matcher": "read_file|list_directory"
        }
      }
    }
  ]
}
