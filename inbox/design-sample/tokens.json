{
  "name": "Canvas Intrinsic Design Sample",
  "version": "sample-0.1",
  "recipes": {
    "compactType": {
      "ratio": 1.125,
      "ratioName": "Major Second",
      "fluid": false
    },
    "displayType": {
      "minRatio": 1.125,
      "minRatioName": "Major Second",
      "maxRatio": 1.25,
      "maxRatioName": "Major Third",
      "fluid": true
    },
    "compactSpace": {
      "ratio": 1.125,
      "fluid": false
    },
    "displaySpace": {
      "minRatio": 1.125,
      "maxRatio": 1.25,
      "fluid": true
    }
  },
  "primitive": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, \"avenir next\", avenir, \"segoe ui\", \"helvetica neue\", helvetica, Cantarell, Ubuntu, roboto, noto, arial, sans-serif",
      "serif": "Iowan Old Style, Apple Garamond, Baskerville, Times New Roman, Droid Serif, Times, Source Serif Pro, serif"
    },
    "type": {
      "compact": {
        "x-small": "0.79rem",
        "small": "0.889rem",
        "normal": "1rem",
        "medium": "1.125rem",
        "large": "1.266rem",
        "x-large": "1.424rem",
        "2x-large": "1.602rem",
        "3x-large": "1.802rem",
        "4x-large": "2.027rem",
        "5x-large": "3.0518rem"
      },
      "display": {
        "heading-xxs": {
          "min": "1.125rem",
          "max": "1.25rem",
          "value": "clamp(1.125rem, 1.0665rem + 0.25vw, 1.25rem)"
        },
        "heading-xs": {
          "min": "1.266rem",
          "max": "1.563rem",
          "value": "clamp(1.266rem, 1.1269rem + 0.594vw, 1.563rem)"
        },
        "heading-sm": {
          "min": "1.424rem",
          "max": "1.953rem",
          "value": "clamp(1.424rem, 1.1762rem + 1.058vw, 1.953rem)"
        },
        "heading-md": {
          "min": "1.602rem",
          "max": "2.441rem",
          "value": "clamp(1.602rem, 1.2088rem + 1.678vw, 2.441rem)"
        },
        "heading-lg": {
          "min": "1.802rem",
          "max": "3.052rem",
          "value": "clamp(1.802rem, 1.2163rem + 2.5vw, 3.052rem)"
        },
        "heading-xl": {
          "min": "2.027rem",
          "max": "3.815rem",
          "value": "clamp(2.027rem, 1.189rem + 3.576vw, 3.815rem)"
        },
        "heading-xxl": {
          "min": "2.2807rem",
          "max": "4.7684rem",
          "value": "clamp(2.2807rem, 1.1146rem + 4.9754vw, 4.7684rem)"
        },
        "heading-xxxl": {
          "min": "2.5658rem",
          "max": "5.9605rem",
          "value": "clamp(2.5658rem, 0.9745rem + 6.7894vw, 5.9605rem)"
        }
      }
    },
    "space": {
      "compact": {
        "x-small": "0.64rem",
        "small": "0.8rem",
        "normal": "1rem",
        "medium": "1.2rem",
        "large": "1.44rem"
      },
      "display": {
        "x-large": "clamp(1.424rem, 0.1124rem + 3.1796vw, 2.827rem)",
        "xx-large": "clamp(1.602rem, 0.1483rem + 3.5241vw, 3.157rem)",
        "xxx-large": "clamp(1.802rem, -1.7981rem + 8.7275vw, 5.653rem)",
        "xxxx-large": "clamp(2.027rem, -3.5503rem + 13.5207vw, 7.993rem)",
        "xxxxx-large": "clamp(2.280375rem, -6.1535rem + 20.4458vw, 11.302102rem)"
      }
    },
    "measure": {
      "prose": "65ch",
      "proseMin": "60ch",
      "proseMax": "75ch"
    },
    "radius": {
      "small": "4px"
    }
  },
  "semantic": {
    "type.body": "{primitive.type.compact.normal}",
    "type.lede": "{primitive.type.compact.large}",
    "type.articleTitle": "{primitive.type.compact.4x-large}",
    "type.sectionTitle": "{primitive.type.display.heading-lg.value}",
    "type.heroTitle": "{primitive.type.display.heading-xl.value}",
    "space.inlineGap": "{primitive.space.compact.small}",
    "space.stackGap": "{primitive.space.compact.normal}",
    "space.cardPadding": "{primitive.space.compact.large}",
    "space.sectionY": "{primitive.space.display.xxx-large}",
    "space.heroY": "{primitive.space.display.xxxx-large}",
    "measure.prose": "{primitive.measure.prose}"
  },
  "component": {
    "article.body.fontSize": "{semantic.type.body}",
    "article.title.fontSize": "{semantic.type.articleTitle}",
    "article.content.maxWidth": "{semantic.measure.prose}",
    "section.heading.fontSize": "{semantic.type.sectionTitle}",
    "section.paddingBlock": "{semantic.space.sectionY}",
    "hero.heading.fontSize": "{semantic.type.heroTitle}",
    "hero.paddingBlock": "{semantic.space.heroY}",
    "card.padding": "{semantic.space.cardPadding}"
  }
}

